    "Before cutting, the rollers run the sheet forward and back to mark their tracks, so thick or slippery material doesn’t slip. Done once per send." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cortar, los rodillos llevan la hoja hacia adelante y hacia atrás para marcar su recorrido, así el material grueso o resbaladizo no se desliza. Una vez por envío."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de cortar, os roletes levam a folha para a frente e para trás para marcar o caminho deles, e o material grosso ou liso não escorrega. Uma vez por envio."
          }
        }
      }
