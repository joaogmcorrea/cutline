    "(Texto cortado: o relatório completo foi copiado; cole aqui.)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Text cut short: the full report was copied; paste it here.)"
          }
        }
