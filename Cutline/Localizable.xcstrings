    "%lld images inside shapes went in as one opaque image: Cutline can’t write Silhouette Studio’s tiled or transparent patterns yet." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld image inside a shape went in as one opaque image: Cutline can’t write Silhouette Studio’s tiled or transparent patterns yet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld images inside shapes went in as one opaque image: Cutline can’t write Silhouette Studio’s tiled or transparent patterns yet."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld imagen dentro de una forma entró como una sola imagen opaca: Cutline aún no puede escribir los patrones en mosaico o transparentes de Silhouette Studio."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld imágenes dentro de formas entraron como una sola imagen opaca: Cutline aún no puede escribir los patrones en mosaico o transparentes de Silhouette Studio."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld imagem dentro de forma entrou como uma imagem opaca: o Cutline ainda não grava os padrões repetidos ou transparentes do Silhouette Studio."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld imagens dentro de formas entraram como uma imagem opaca: o Cutline ainda não grava os padrões repetidos ou transparentes do Silhouette Studio."
                }
              }
            }
          }
        }
      }
