    "Cutline and Silhouette Studio can't use the cutter at the same time. While Studio is open, Cutline won't connect or send; once it closes, the connection comes back on its own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutline y Silhouette Studio no pueden usar la cortadora a la vez. Mientras Studio esté abierto, Cutline no se conecta ni envía; cuando se cierre, la conexión vuelve sola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cutline e o Silhouette Studio não conseguem usar a cortadora ao mesmo tempo. Enquanto o Studio estiver aberto, o Cutline não conecta nem envia; quando ele fechar, a conexão volta sozinha."
          }
        }
      }
    },
