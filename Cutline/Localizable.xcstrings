    },
    "**%@ cm** de corte" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%@ cm** of cutting"
          }
        }
      }
    },
    "**Print & Cut:** imprima a página em 100 % (⌘P) e ponha a folha na base na mesma posição da tela, com o quadrado no canto superior esquerdo. A máquina lê as marcas antes de cortar (até 40 s)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Print & Cut:** print the page at 100% (⌘P) and place the sheet on the mat in the same position as on screen, with the square in the top-left corner. The machine reads the marks before cutting (up to 40 s)."
          }
        }
      }
    },
    "0 pt aparece na tela, não imprime e indica o corte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 pt shows on screen, doesn’t print and marks the cut."
          }
        }
      }
    },
