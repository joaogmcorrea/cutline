        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relatório foi copiado: cole no corpo do e-mail."
          }
        }
      }
    },
    "The result is empty — do the shapes overlap?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resultado quedó vacío. ¿Las formas se superponen?"
