        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resultado ficou vazio — as formas não se sobrepõem?"
          }
        }
      }
    },
    "The screen shows the colors as this profile prints them; RGB, HSL, hex and imported RGB colors convert through it. Documents can have their own (Edit › Assign Profile…)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla muestra los colores como este perfil los imprime; RGB, HSL, hex y los colores RGB importados se convierten con él. Cada documento puede tener el suyo (Edición › Asignar perfil…)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela mostra as cores como este perfil as imprime; RGB, HSL, hex e as cores RGB importadas convertem por ele. Cada documento pode ter o seu (Editar › Atribuir perfil…)."
          }
        }
      }
    },
    "The script couldn’t be installed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo instalar el script."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível instalar o script."
          }
        }
      }
    },
    "The selection has no gradient: click the swatch to fill it with this one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección no tiene degradado: haz clic en la muestra para rellenarla con este."
          }
