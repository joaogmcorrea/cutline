<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cutline's document types and updates. The rest of the Info.plist is generated by Xcode (GENERATE_INFOPLIST_FILE).
     It lives outside the Cutline/ folder because the synchronized folder would copy the file as a resource. -->
<plist version="1.0">
<dict>
	<!-- Sparkle: the appcast of the latest version published on GitHub Releases (made by the distribution script) and the
	     public key that checks each update's signature. The private key stays outside the repository. -->
	<key>SUFeedURL</key>
	<string>https://github.com/joaogmcorrea/cutline/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>T5Q5e1wRXo+JCL5xSr09EyRzb/bcQ37hULV4HC4K5PE=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Cutline Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.joaogmcorrea.cutline.documento</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Silhouette Studio Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.studio3</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.joaogmcorrea.cutline.documento</string>
			<key>UTTypeDescription</key>
			<string>Cutline Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cutline</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.studio3</string>
			<key>UTTypeDescription</key>
			<string>Silhouette Studio Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>studio3</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
