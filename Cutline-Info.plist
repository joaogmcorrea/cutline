<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cutline's document types and updates. The rest of the Info.plist is generated by Xcode (GENERATE_INFOPLIST_FILE).
     It lives outside the Cutline/ folder because the synchronized folder would copy the file as a resource. -->
<plist version="1.0">
<dict>
	<!-- Sparkle: the appcast of the latest version published on GitHub Releases (made by the distribution script) and the
	     public key that checks each update's signature. The private key stays outside the repository. -->
	<key>SUFeedURL</key>
	<string>https://github.com/joaogmcorrea/cutline/releases/latest/download/appcast-$(MARKETING_VERSION).xml</string>
	<key>SUPublicEDKey</key>
	<string>T5Q5e1wRXo+JCL5xSr09EyRzb/bcQ37hULV4HC4K5PE=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- File › Open from Canva…: the address of Cutline's backend for Canva (_site/canva in the project folder), which
	     keeps the Canva credentials. Empty, the menu item doesn't show up: fill it in only once Canva has approved the
	     integration (https://cutline.joaocorrea.design/canva/). -->
	<key>CanvaServer</key>
	<string></string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Cutline Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.joaogmcorrea.cutline.documento</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Silhouette Studio Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.studio3</string>
			</array>
		</dict>
		<!-- The PDF that the Illustrator script "Send to Cutline" (Cutline/Illustrator) saves and opens with File.execute():
		     a type of its own, so that it opens here and not in the PDF app. Cutline imports it into a new document and
		     deletes it (Illustrator/IllustratorScript.swift). -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Artwork from Illustrator</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.joaogmcorrea.cutline.send</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.joaogmcorrea.cutline.documento</string>
			<key>UTTypeDescription</key>
			<string>Cutline Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cutline</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.joaogmcorrea.cutline.send</string>
			<key>UTTypeDescription</key>
			<string>Artwork from Illustrator</string>
			<!-- Not com.adobe.pdf: without Cutline, no other app should open it (the script says Cutline didn't open). -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cutlinesend</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.studio3</string>
			<key>UTTypeDescription</key>
			<string>Silhouette Studio Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>studio3</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
